---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PubList from '../components/PubList.astro';
import Avatar from '../components/Avatar.astro';
import { SITE, THEMES } from '../data/site';
import { url } from '../lib/url';
import { getArticles, getPeopleByGroup } from '../lib/content';

const articles = (await getArticles()).slice(0, 3);
const { director } = await getPeopleByGroup();
const pubs = (await getCollection('publications', ({ data }) => data.tier === 'core'))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);
---

<Base>
  <section class="hero">
    <svg class="hero-arc" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M22.42 10.62A8.375 8.375 0 1 0 22.42 21.38" fill="none" stroke="currentColor" stroke-width="3.75" stroke-linecap="round" />
      <circle cx="16" cy="16" r="2.1" fill="var(--teal)" />
    </svg>
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{SITE.institution}</p>
        <h1>Conversation is the interface. <span class="hl">We study what it should be.</span></h1>
        <p class="lede">{SITE.description}</p>
        <p class="ctas">
          <a class="button" href={url('research')}>Our research</a>
          <a class="button ghost" href={url('publications')}>Publications</a>
        </p>
      </div>
      <div class="dialogue" aria-hidden="true">
        <p class="bubble human">Can you help me practise telling a patient some difficult news?</p>
        <p class="bubble agent">Of course. I'll play the patient. I'll react the way a real person might, and afterwards we can talk about how it went.</p>
        <p class="bubble human short">Okay. Let's begin.</p>
        <p class="typing"><span></span><span></span><span></span></p>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="section-title"><h2>Research areas</h2></div>
    <ol class="themes">
      {THEMES.map((t) => (
        <li>
          <a href={url(`research#${t.id}`)}>
            <span class="num">{t.number}</span>
            <h3>{t.title}</h3>
            <p>{t.lede}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {articles.length > 0 && (
    <section class="wrap">
      <div class="section-title">
        <h2>Latest articles</h2>
        <a class="more" href={url('articles')}>All articles →</a>
      </div>
      <div class="grid">
        {articles.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}

  <section class="wrap">
    <div class="section-title">
      <h2>Recent publications</h2>
      <a class="more" href={url('publications')}>All publications →</a>
    </div>
    <PubList pubs={pubs} />
  </section>

  <section class="wrap">
    <div class="section-title">
      <h2>Directors</h2>
      <a class="more" href={url('people')}>All people →</a>
    </div>
    <ul class="directors">
      {director.map((p) => (
        <li>
          <a href={url(`people/${p.id}`)}>
            <Avatar name={p.data.name} photo={p.data.photo} size={72} />
            <span>
              <strong>{p.data.name}</strong>
              <small>{p.data.status}</small>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    background: var(--navy); color: #fff;
    padding: 6rem 0; margin-bottom: 4.5rem;
  }
  .hero-arc {
    position: absolute; z-index: -1; right: -14rem; top: 50%; width: 46rem; height: 46rem;
    transform: translateY(-50%); color: #ffffff; opacity: 0.05;
  }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 4rem; align-items: center; }
  .hero .eyebrow { color: var(--steel); }
  .hero h1 { color: #fff; }
  .hl { display: block; color: #a9c4de; text-wrap: balance; }
  .hero .button { background: #fff; color: var(--navy); }
  .hero .button.ghost { background: transparent; color: #fff; }
  .hero .lede { color: #c9d6e3; }
  .hero .lede { margin: 1.5rem 0 0; }
  .ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 2.25rem 0 0; }

  .dialogue { display: flex; flex-direction: column; gap: 0.85rem; }
  .bubble {
    margin: 0; padding: 0.95rem 1.25rem; border-radius: 22px; max-width: 86%;
    font-size: 0.98rem; line-height: 1.5;
    animation: rise 0.6s ease both;
  }
  .human { align-self: flex-end; background: var(--blue); color: #fff; border-bottom-right-radius: 6px; }
  .agent { align-self: flex-start; background: #fff; color: var(--navy); border-bottom-left-radius: 6px; animation-delay: 0.4s; }
  .short { animation-delay: 0.8s; }
  .typing {
    align-self: flex-start; display: flex; gap: 5px; margin: 0; padding: 0.85rem 1.1rem;
    background: var(--navy-2); border-radius: 22px; border-bottom-left-radius: 6px;
    animation: rise 0.6s 1.2s ease both;
  }
  .typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--steel); animation: blink 1.2s infinite ease-in-out; }
  .typing span:nth-child(2) { animation-delay: 0.15s; }
  .typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  @keyframes blink { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .bubble, .typing, .typing span { animation: none; } }

  .themes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .themes a {
    display: block; height: 100%; padding: 1.75rem; border-radius: var(--radius);
    background: var(--bg-raised); border: 1px solid var(--rule); color: inherit; text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .themes a:hover { border-color: var(--steel); transform: translateY(-3px); box-shadow: 0 12px 30px -18px #0b254566; }
  .num {
    display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; margin-bottom: 1.1rem;
    font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: var(--bg); background: var(--ink);
  }
  .themes li:nth-child(2) .num { background: var(--steel); color: var(--navy); }
  .themes li:nth-child(3) .num { background: var(--blue); color: #fff; }
  .themes h3 { margin-bottom: 0.6rem; }
  .themes p { color: var(--ink-soft); margin: 0; font-size: 0.97rem; line-height: 1.6; }

  .more { margin-left: auto; font-size: 0.92rem; font-weight: 500; text-decoration: none; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1.5rem; }

  .directors { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1.5rem; }
  .directors a { padding: 1.25rem; border-radius: var(--radius); background: var(--bg-tint); transition: box-shadow 0.2s, transform 0.2s; }
  .directors a:hover { box-shadow: 0 14px 32px -18px #0b254559; transform: translateY(-2px); }
  .directors a { display: flex; gap: 1rem; align-items: center; color: inherit; text-decoration: none; }
  .directors strong { display: block; font-family: var(--font-display); font-weight: 500; font-size: 1.1rem; }
  .directors a:hover strong { color: var(--accent); }
  .directors small { display: block; color: var(--ink-soft); font-size: 0.88rem; line-height: 1.45; margin-top: 0.15rem; }

  @media (max-width: 860px) {
    .hero { padding: 3.5rem 0 4rem; }
    .hero-grid { gap: 2.5rem; }
    .hero-arc { right: -20rem; opacity: 0.04; }
    .hero-grid { grid-template-columns: 1fr; }
    .themes { grid-template-columns: 1fr; }
  }
</style>
