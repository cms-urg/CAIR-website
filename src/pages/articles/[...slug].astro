---
import { getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import { getArticles } from '../../lib/content';
import { url, formatDate } from '../../lib/url';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const authors = await getEntries(article.data.authors);
const d = article.data;
---

<Base title={d.title} description={d.summary} type="article">
  <article class="wrap">
    <header class="head">
      <a class="back" href={url('articles')}>← All articles</a>
      {d.draft && <p class="draft">Draft — not visible on the published site</p>}
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <div class="byline">
        <ul class="authors">
          {authors.map((a) => (
            <li>
              <a href={url(`people/${a.id}`)}>
                <Avatar name={a.data.name} photo={a.data.photo} size={44} />
                <span>{a.data.name}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="date">
          <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></>}
        </p>
      </div>
      {d.tags.length > 0 && <p class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</p>}
    </header>

    <div class="prose body"><Content /></div>
  </article>
</Base>

<style>
  .head { max-width: var(--prose); margin: 0 auto; padding: 2rem 0 2.5rem; border-bottom: 1px solid var(--rule); }
  .back { display: inline-block; margin-bottom: 2rem; font-size: 0.92rem; text-decoration: none; }
  .draft { display: inline-block; background: var(--accent-soft); color: var(--accent); font-weight: 600; font-size: 0.85rem; padding: 0.3rem 0.8rem; border-radius: 999px; }
  .summary { font-size: 1.25rem; color: var(--ink-soft); margin: 0 0 1.75rem; }
  .byline { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
  .authors { list-style: none; display: flex; flex-wrap: wrap; gap: 1.25rem; padding: 0; margin: 0; }
  .authors a { display: flex; align-items: center; gap: 0.6rem; color: var(--ink); font-weight: 600; text-decoration: none; }
  .authors a:hover span { color: var(--accent); }
  .date { margin: 0; color: var(--ink-faint); font-size: 0.92rem; }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 1.25rem 0 0; }
  .body { margin: 2.5rem auto 0; }
</style>
