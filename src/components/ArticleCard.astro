---
import { getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import type { Article } from '../lib/content';
import { url, formatDate } from '../lib/url';
import Placeholder from './Placeholder.astro';

interface Props { article: Article }
const { article } = Astro.props;
const d = article.data;
const authors = await getEntries(d.authors);
---

<article class="card">
  <div class="thumb">
    {d.cover ? <Image src={d.cover} alt={d.coverAlt ?? ''} width={720} /> : <Placeholder />}
  </div>
  <div class="body">
    <p class="meta">
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      {d.draft && <span class="draft">Draft</span>}
    </p>
    <h3><a href={url(`articles/${article.id}`)}>{d.title}</a></h3>
    <p class="summary">{d.summary}</p>
    <p class="by">{authors.map((a) => a.data.name).join(', ')}</p>
  </div>
</article>

<style>
  .card {
    position: relative; display: flex; flex-direction: column; height: 100%;
    border-radius: var(--radius); overflow: hidden;
    background: var(--bg-tint); box-shadow: 0 1px 2px #0b25450f;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .card:hover { box-shadow: 0 14px 32px -18px #0b254559; transform: translateY(-2px); }
  .card:has(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .thumb { aspect-ratio: 16 / 9; overflow: hidden; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; padding: 1.25rem 1.4rem 1.4rem; }
  p { margin: 0; }
  .meta { font-size: 0.8rem; color: var(--ink-faint); display: flex; gap: 0.6rem; }
  .draft { color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  h3 { margin: 0; font-size: 1.2rem; line-height: 1.3; text-wrap: pretty; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .card:hover h3 a { color: var(--accent); }
  .summary { color: var(--ink-soft); font-size: 0.93rem; line-height: 1.55; flex: 1; }
  .by { font-size: 0.85rem; font-weight: 600; color: var(--ink-soft); margin-top: 0.35rem; }
</style>
