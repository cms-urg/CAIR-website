---
import { NAV, SITE } from '../data/site';
import { url } from '../lib/url';
import Logo from './Logo.astro';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').split('/')[1] ?? '';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url()} aria-label={`${SITE.name} — home`}>
      <Logo variant="wordmark" height={30} />
      <span class="brand-sub">Conversational AI Research</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 0.9rem; color: var(--ink); text-decoration: none; }
  .brand-sub {
    font-family: var(--font-display); font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-faint);
    padding-left: 0.9rem; border-left: 1px solid var(--rule); line-height: 1.3; max-width: 9rem;
  }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 0; padding: 0; }
  nav a {
    display: block; padding: 0.45rem 0.9rem; border-radius: 999px;
    font-family: var(--font-display); font-size: 0.95rem; font-weight: 500;
    color: var(--ink-soft); text-decoration: none;
  }
  nav a:hover { color: var(--ink); background: var(--chip); }
  nav a[aria-current='page'] { color: var(--ink); background: var(--chip); box-shadow: inset 0 -2px 0 var(--teal); }
  @media (max-width: 720px) {
    .brand-sub { display: none; }
    nav { width: 100%; overflow-x: auto; }
    ul { flex-wrap: nowrap; }
    nav a { padding: 0.35rem 0.7rem; font-size: 0.9rem; }
  }
</style>
