---
// Monochrome icons (currentColor). Brand marks come from simple-icons at build
// time, so no icon JS ships to the browser. LinkedIn was removed from
// simple-icons at LinkedIn's request, so it and the generic icons are drawn here.
import { siGithub, siOrcid, siGooglescholar, siRss } from 'simple-icons';

export type IconName = 'email' | 'website' | 'scholar' | 'orcid' | 'github' | 'linkedin' | 'rss' | 'link' | 'pdf' | 'poster';
interface Props { name: IconName; size?: number }
const { name, size = 18 } = Astro.props;

const brand: Partial<Record<IconName, string>> = {
  github: siGithub.path,
  orcid: siOrcid.path,
  scholar: siGooglescholar.path,
  rss: siRss.path,
};
---

<svg class="icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  {brand[name] ? (
    <path d={brand[name]} fill="currentColor" />
  ) : name === 'linkedin' ? (
    <g fill="currentColor">
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" />
    </g>
  ) : name === 'link' ? (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" />
      <path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" />
    </g>
  ) : name === 'pdf' ? (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5M9 13h6M9 17h4" />
    </g>
  ) : name === 'poster' ? (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="13" rx="2" />
      <path d="M8 21l4-4 4 4M7 9h6M7 12h10" />
    </g>
  ) : name === 'email' ? (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </g>
  ) : (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
    </g>
  )}
</svg>

<style>
  .icon { display: block; flex: none; }
</style>
