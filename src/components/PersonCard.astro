---
import type { Person } from '../lib/content';
import { url } from '../lib/url';
import Avatar from './Avatar.astro';

interface Props { person: Person; profile?: boolean }
const { person, profile = false } = Astro.props;
const { name, status, photo, link } = person.data;
// Members link out (LinkedIn / personal site) like the students page; directors
// (profile=true) and anyone without a link go to their on-site profile page.
const external = !profile && Boolean(link);
const href = external ? link : url(`people/${person.id}`);
---

<li>
  <a class="card" href={href} rel={external ? 'noopener' : undefined}>
    <span class="photo"><Avatar name={name} photo={photo} size={240} shape="square" /></span>
    <span class="name">{name}</span>
    <span class="status">{status}</span>
  </a>
</li>

<style>
  .card {
    display: flex; flex-direction: column; align-items: center; text-align: center; height: 100%;
    padding: 1rem 1rem 1.35rem; border-radius: var(--radius);
    background: var(--bg-tint); box-shadow: 0 1px 2px #0b25450f;
    color: inherit; text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .card:hover { box-shadow: 0 14px 32px -18px #0b254559; transform: translateY(-2px); }
  .photo { width: 100%; }
  .photo :global(.avatar) { width: 100%; height: auto; aspect-ratio: 1 / 1.05; }
  .name { font-family: var(--font-display); font-weight: 600; font-size: 1.08rem; line-height: 1.25; margin-top: 1rem; }
  .card:hover .name { color: var(--accent); }
  .status { color: var(--ink-faint); font-size: 0.82rem; line-height: 1.45; margin-top: 0.3rem; text-wrap: balance; }
</style>
