---
import { SITE } from '../data/site';
import { url } from '../lib/url';
import Logo from './Logo.astro';
import Icon, { type IconName } from './Icon.astro';
const year = new Date().getFullYear();

const LINKS: { icon: IconName; label: string; href: string }[] = [
  { icon: 'email', label: 'Email', href: `mailto:${SITE.email}` },
  { icon: 'linkedin', label: 'LinkedIn', href: SITE.linkedin },
  { icon: 'github', label: 'GitHub', href: SITE.github },
  { icon: 'rss', label: 'RSS feed', href: url('rss.xml') },
];
---

<footer class="site-footer">
  <div class="wrap inner">
    <a href={url()} class="brand" aria-label={`${SITE.name} — home`}><Logo variant="wordmark" height={36} /></a>
    <p class="tagline">Conversational AI Research</p>
    <p class="muted">{SITE.institution} · Toronto, Canada</p>
    <ul class="links">
      {LINKS.map((l) => (
        <li>
          <a href={l.href} aria-label={l.label} title={l.label} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
            <Icon name={l.icon} size={18} />
          </a>
        </li>
      ))}
    </ul>
    <p class="copy">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  /* Always navy, matching the brand banner, regardless of theme */
  .site-footer { background: var(--navy); color: #fff; padding: 3.5rem 0 2.25rem; }
  .inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .brand { color: #fff; }
  .tagline {
    font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--steel); margin: 0.85rem 0 0.35rem;
  }
  .muted { color: var(--steel); margin: 0; font-size: 0.9rem; }
  .links { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; gap: 0.6rem; }
  .links a {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%;
    color: var(--steel); background: #ffffff0f;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }
  .links a:hover { color: var(--navy); background: #fff; transform: translateY(-2px); }
  .copy {
    margin: 2rem 0 0; padding-top: 1.25rem; width: 100%;
    border-top: 1px solid #ffffff1a; font-size: 0.8rem; color: var(--steel);
  }
</style>
