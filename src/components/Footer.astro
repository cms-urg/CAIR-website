---
import { SITE } from '../data/site';
import { url } from '../lib/url';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="id">
      <Logo variant="wordmark" height={40} />
      <p class="tagline">Conversational AI Research</p>
      <p class="muted">{SITE.institution} · Toronto, Canada</p>
    </div>
    <ul class="links">
      <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      <li><a href={SITE.linkedin} rel="noopener">LinkedIn</a></li>
      <li><a href={url('rss.xml')}>RSS</a></li>
    </ul>
  </div>
  <div class="wrap bottom">© {year} {SITE.name}</div>
</footer>

<style>
  /* Always navy, matching the brand banner, regardless of theme */
  .site-footer { background: var(--navy); color: #fff; padding: 3rem 0 2rem; --teal: #19b8ac; }
  .cols { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .tagline {
    font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--steel); margin: 0.7rem 0 0.9rem;
  }
  .muted { color: var(--steel); margin: 0; font-size: 0.92rem; }
  .links { list-style: none; padding: 0; margin: 0; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .links a {
    display: block; padding: 0.45rem 1rem; border-radius: 999px;
    font-family: var(--font-display); font-weight: 500; font-size: 0.92rem;
    color: #fff; text-decoration: none; box-shadow: inset 0 0 0 1.5px #ffffff33;
  }
  .links a:hover { box-shadow: inset 0 0 0 1.5px var(--teal); }
  .bottom { font-size: 0.82rem; color: var(--steel); border-top: 1px solid #ffffff1a; padding-top: 1.25rem; }
</style>
