---
import type { CollectionEntry } from 'astro:content';
import { THEMES } from '../data/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';

interface Props { pubs: CollectionEntry<'publications'>[] }
const { pubs } = Astro.props;

const themeTitle = (id?: string) => THEMES.find((t) => t.id === id)?.title;
const typeLabel: Record<string, string> = {
  conference: 'Conference', journal: 'Journal', chapter: 'Book chapter', preprint: 'Preprint', other: 'Other',
};
// Bold the lab directors' names wherever they appear in an author list.
const LAB = ['Brian Harrington', 'Steve Joordens'];
const highlight = (authors: string) =>
  LAB.reduce((s, n) => s.replaceAll(n, `<strong>${n}</strong>`), authors);
// pdf/poster may be full URLs or paths under /public
const asset = (p?: string) => (p ? (/^https?:/.test(p) ? p : url(p)) : undefined);
---

<ul class="pubs">
  {pubs.map(({ data: p }) => {
    const pdf = asset(p.pdf);
    const poster = asset(p.poster);
    const href = p.url ?? pdf;
    return (
      <li class="card">
        <div class="thumb">
          {p.image ? (
            <img src={url(p.image)} alt="" loading="lazy" />
          ) : (
            <Placeholder />
          )}
          <span class="badge">{typeLabel[p.type]} · {p.year}</span>
        </div>
        <h3 class="title">
          {href ? <a href={href} rel="noopener">{p.title}</a> : p.title}
        </h3>
        <p class="authors" set:html={highlight(p.authors)} />
        <p class="venue">{p.venue}, {p.year}</p>
        <div class="foot">
          {p.theme && <span class="theme">{themeTitle(p.theme)}</span>}
          <span class="icons">
            {p.url && <a href={p.url} rel="noopener" aria-label="Paper" title="Paper"><Icon name="link" size={18} /></a>}
            {pdf && <a href={pdf} rel="noopener" aria-label="PDF" title="PDF"><Icon name="pdf" size={18} /></a>}
            {poster && <a href={poster} rel="noopener" aria-label="Poster" title="Poster"><Icon name="poster" size={18} /></a>}
          </span>
        </div>
      </li>
    );
  })}
</ul>

<style>
  .pubs {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1.5rem;
  }
  .card {
    display: flex; flex-direction: column;
    padding: 1.1rem 1.1rem 1.25rem; border-radius: var(--radius);
    background: var(--bg-tint); box-shadow: 0 1px 2px #0b25450f;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .card:hover { box-shadow: 0 14px 32px -18px #0b254559; transform: translateY(-2px); }

  .thumb { position: relative; aspect-ratio: 2 / 1; border-radius: 14px; overflow: hidden; margin-bottom: 1.1rem; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .badge {
    position: absolute; left: 0.7rem; bottom: 0.7rem;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em;
    padding: 0.22rem 0.6rem; border-radius: 999px;
    background: #ffffffe6; color: var(--navy);
  }

  .title { font-size: 1.08rem; line-height: 1.35; margin: 0 0 0.55rem; padding: 0 0.15rem; text-wrap: pretty; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { color: var(--accent); text-decoration: underline; }
  p { margin: 0; padding: 0 0.15rem; }
  .authors { color: var(--ink-soft); font-size: 0.88rem; line-height: 1.5; }
  .authors :global(strong) { color: var(--ink); font-weight: 600; }
  .venue { color: var(--ink-faint); font-size: 0.85rem; line-height: 1.5; margin-top: 0.3rem; font-style: italic; }

  .foot {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    margin-top: auto; padding: 1rem 0.15rem 0;
  }
  .theme { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.78rem; font-weight: 600; color: var(--ink-soft); }
  .theme::before { content: ''; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--teal); flex: none; }
  .icons { display: flex; gap: 0.35rem; margin-left: auto; }
  .icons a {
    display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    color: var(--ink-soft); transition: background 0.15s, color 0.15s;
  }
  .icons a:hover { background: var(--ink); color: var(--bg); }
</style>
