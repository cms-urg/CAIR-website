---
import type { CollectionEntry } from 'astro:content';
import { THEMES } from '../data/site';

interface Props { pubs: CollectionEntry<'publications'>[]; showYear?: boolean }
const { pubs, showYear = true } = Astro.props;
const themeTitle = (id?: string) => THEMES.find((t) => t.id === id)?.title;
const typeLabel: Record<string, string> = {
  conference: 'Conference', journal: 'Journal', chapter: 'Book chapter', preprint: 'Preprint', other: 'Other',
};
// Bold the lab directors' names wherever they appear in an author list.
const LAB = ['Brian Harrington', 'Steve Joordens'];
const highlight = (authors: string) =>
  LAB.reduce((s, n) => s.replaceAll(n, `<strong>${n}</strong>`), authors);
---

<ol class="pubs">
  {pubs.map(({ data: p }) => (
    <li>
      {showYear && <span class="year">{p.year}</span>}
      <div>
        <p class="title">
          {p.url ? <a href={p.url} rel="noopener">{p.title}</a> : p.title}
        </p>
        <p class="authors" set:html={highlight(p.authors)} />
        <p class="venue"><em>{p.venue}</em></p>
        <p class="meta">
          <span class="tag">{typeLabel[p.type]}</span>
          {p.theme && <span class="theme">{themeTitle(p.theme)}</span>}
          {p.pdf && <a href={p.pdf} rel="noopener">PDF</a>}
        </p>
      </div>
    </li>
  ))}
</ol>

<style>
  .pubs { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 4rem 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--rule); }
  li:has(> div:only-child) { grid-template-columns: 1fr; }
  .year { font-family: var(--font-display); font-size: 1.15rem; color: var(--ink-faint); }
  p { margin: 0; }
  .title { font-family: var(--font-display); font-size: 1.15rem; line-height: 1.3; margin-bottom: 0.35rem; }
  .title a { color: var(--ink); }
  .title a:hover { color: var(--accent); }
  .authors { color: var(--ink-soft); font-size: 0.95rem; }
  .authors :global(strong) { color: var(--ink); font-weight: 600; }
  .venue { color: var(--ink-faint); font-size: 0.92rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-top: 0.5rem; font-size: 0.82rem; }
  .theme { color: var(--accent); font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem; }
  .theme::before { content: ""; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--teal); }
  @media (max-width: 560px) { li { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
